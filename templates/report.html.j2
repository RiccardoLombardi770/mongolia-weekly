<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.title }} — {{ label }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}style.css">
</head>
<body class="lang-en">

<button id="menu-btn" aria-label="Toggle archive"><span></span><span></span><span></span></button>

<aside id="sidebar">
  <div class="side-brand">{{ site.title }}</div>
  <div class="side-label"><span class="en">Archive</span><span class="mn">Архив</span></div>
  <nav>
    {% for w in archive %}
    <a href="{{ root }}{{ w.href }}" class="{{ 'active' if w.slug == current else '' }}">{{ w.label }}</a>
    {% endfor %}
  </nav>
</aside>

<main>
  <header class="masthead">
    <div class="lang-toggle" role="group" aria-label="Language">
      <button data-lang="en" class="active">EN</button>
      <button data-lang="mn">MN</button>
    </div>
    <div class="title">{{ site.title }}</div>
    <div class="tagline">{{ site.subtitle }} · {{ label }}</div>
  </header>

  {% if report.insights %}
  <section class="insights">
    <h2><span class="en">Overall insights</span><span class="mn">Ерөнхий дүгнэлт</span></h2>
    <ul>
      {% for ins in report.insights %}
      <li><span class="en">{{ ins.en }}</span><span class="mn">{{ ins.mn }}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section class="filter">
    <span class="filter-label"><span class="en">Filter by agency</span><span class="mn">Байгууллагаар шүүх</span></span>
    <div class="chips">
      <button class="chip active" data-agency="__all">All</button>
      {% for ag in agencies %}
      <button class="chip" data-agency="{{ ag }}">{{ ag }}</button>
      {% endfor %}
    </div>
  </section>

  {% for section in report.sections %}
  <section class="theme" data-theme>
    <h3 class="theme-head"><span class="en">{{ section.theme }}</span><span class="mn">{{ section.theme_mn }}</span></h3>
    <div class="cards">
      {% for item in section['items'] %}
      <article class="card" data-agencies="{{ item.agencies | join('|') }}">
        <p><span class="en">{{ item.en }}</span><span class="mn">{{ item.mn }}</span></p>
        <div class="card-foot">
          {% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.source }}</a>{% else %}<span>{{ item.source }}</span>{% endif %}
          {% for ag in item.agencies %}<span class="tag">{{ ag }}</span>{% endfor %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  {% if report.also_noted %}
  <section class="theme also" data-theme>
    <h3 class="theme-head"><span class="en">Also noted</span><span class="mn">Мөн тэмдэглэх нь</span></h3>
    <div class="cards">
      {% for item in report.also_noted %}
      <article class="card slim" data-agencies="{{ item.agencies | join('|') }}">
        <p><span class="en">{{ item.en }}</span><span class="mn">{{ item.mn }}</span></p>
        <div class="card-foot">
          {% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.source }}</a>{% else %}<span>{{ item.source }}</span>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <footer class="disclaimer">
    <span class="en">Disclaimer: this monitor is a curated snapshot drawn from open-source media and institutional reports for internal situational awareness, generated using AI tools. The UN cannot vouch for the accuracy of third-party reports; inclusion does not imply endorsement or verification by the United Nations.</span>
    <span class="mn">Тайлбар: энэхүү тойм нь нээлттэй эх сурвалжийн мэдээлэлд тулгуурлан хиймэл оюун ухааны хэрэгсэл ашиглан бэлтгэсэн дотоод хэрэглээний танилцуулга юм. НҮБ гуравдагч талын мэдээллийн үнэн зөвийг баталгаажуулахгүй.</span>
  </footer>
</main>

<script src="{{ root }}app.js"></script>
</body>
</html>
