<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.media_page_title }} — {{ site.title }} · {{ label }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}style.css">
</head>
<body class="lang-en">

<button id="menu-btn" aria-label="Toggle archive"><span></span><span></span><span></span></button>

<aside id="sidebar">
  <div class="side-brand">{{ site.title }}</div>

  <div class="side-label"><span class="en">Sections</span><span class="mn">Хэсэг</span></div>
  <nav class="side-nav">
    <a href="{{ root }}index.html"><span class="en">The week</span><span class="mn">Долоо хоног</span></a>
    <a href="{{ root }}media/index.html" class="active"><span class="en">{{ site.media_page_title }}</span><span class="mn">Хэвлэлд</span></a>
  </nav>

  <div class="side-label"><span class="en">Archive</span><span class="mn">Архив</span></div>
  <nav>
    {% for w in archive %}
    <a href="{{ root }}{{ w.href }}" class="{{ 'active' if w.slug == current else '' }}">{{ w.label }}</a>
    {% endfor %}
  </nav>
</aside>

<main>
  <header class="masthead">
    <div class="lang-toggle" role="group" aria-label="Language">
      <button data-lang="en" class="active">EN</button>
      <button data-lang="mn">MN</button>
    </div>
    <div class="title">{{ site.media_page_title }}</div>
    <div class="tagline">{{ site.title }} · {{ label }}</div>
  </header>

  <section class="insights">
    <h2><span class="en">This week's coverage</span><span class="mn">Энэ долоо хоногийн мэдээлэл</span></h2>
    <p class="overview"><span class="en">{{ doc.overview.en }}</span><span class="mn">{{ doc.overview.mn }}</span></p>
    {% if stats.week.total %}
    <div class="tone-bar" aria-hidden="true">
      {% for t, n in stats.week.tones %}{% if n %}<span class="seg tone-{{ t | lower }}" style="flex:{{ n }}"><em>{{ n }}</em> {{ t }}</span>{% endif %}{% endfor %}
    </div>
    {% endif %}
  </section>

  {% if doc.mentions %}
  <section class="filter">
    <span class="filter-label"><span class="en">Filter</span><span class="mn">Шүүх</span></span>
    <div class="chips">
      <button class="chip active" data-mfilter="__all">All</button>
      {% for t in tones %}<button class="chip tone-chip" data-mfilter="tone:{{ t }}">{{ t }}</button>{% endfor %}
      <button class="chip" data-mfilter="src:yes"><span class="en">Source identified</span><span class="mn">Эх сурвалж тодорхой</span></button>
      <button class="chip" data-mfilter="src:no"><span class="en">Source not identified</span><span class="mn">Эх сурвалж тодорхойгүй</span></button>
    </div>
    <div class="chips">
      {% for ag in agencies %}<button class="chip" data-mfilter="agency:{{ ag }}">{{ ag }}</button>{% endfor %}
    </div>
  </section>

  <section class="theme" data-theme>
    <div class="mentions">
      {% for m in doc.mentions %}
      <article class="mention tone-{{ m.tone | lower }}"
               data-tone="{{ m.tone }}"
               data-agencies="{{ m.agencies | join('|') }}"
               data-matched="{{ 'yes' if m.un_source.matched else 'no' }}">
        <div class="m-head">
          <span class="outlet">{{ m.outlet }}</span>
          {% if m.published %}<span class="dot">·</span><span class="date">{{ m.published | undate }}</span>{% endif %}
          {% if m.language %}<span class="dot">·</span><span class="lang">{{ m.language | upper }}</span>{% endif %}
          <span class="tone-badge">{{ m.tone }}</span>
        </div>

        <h4 class="m-title">
          {% if m.url %}<a href="{{ m.url }}" target="_blank" rel="noopener">{{ m.title }}</a>
          {% else %}{{ m.title }}{% endif %}
        </h4>

        <p class="m-summary"><span class="en">{{ m.summary.en }}</span><span class="mn">{{ m.summary.mn }}</span></p>

        <div class="m-meta">
          {% if m.mention_type %}<span class="tag soft">{{ m.mention_type }}</span>{% endif %}
          {% if m.prominence %}<span class="tag soft">{{ m.prominence }}</span>{% endif %}
          {% for ag in m.agencies %}<span class="tag">{{ ag }}</span>{% endfor %}
          {% for o in m.officials %}<span class="tag soft">{{ o }}</span>{% endfor %}
        </div>

        {% if m.tone_note.en %}
        <p class="m-note"><span class="en">{{ m.tone_note.en }}</span><span class="mn">{{ m.tone_note.mn }}</span></p>
        {% endif %}

        <div class="chain {{ 'chain-none' if not m.un_source.matched else '' }}">
          <span class="chain-label"><span class="en">Refers to</span><span class="mn">Иш татсан</span></span>
          {% if m.un_source.matched %}
            <a class="chain-link" href="{{ m.un_source.url }}" target="_blank" rel="noopener">{{ m.un_source.title or m.un_source.url }}</a>
            <span class="chain-meta">
              {% if m.un_source.agency %}{{ m.un_source.agency }}{% endif %}
              {% if m.un_source.date %} · {{ m.un_source.date | undate }}{% endif %}
              {% if m.un_source.method == 'explicit_link' %}
                · <span class="certain"><span class="en">linked in the article</span><span class="mn">нийтлэлд шууд холбогдсон</span></span>
              {% else %}
                · <span class="probable"><span class="en">probable, {{ m.un_source.confidence }}% confidence</span><span class="mn">магадлалтай, {{ m.un_source.confidence }}%</span></span>
              {% endif %}
            </span>
            {% if m.un_source.reason %}<span class="chain-why">{{ m.un_source.reason }}</span>{% endif %}
          {% else %}
            <span class="chain-link muted"><span class="en">not identified</span><span class="mn">тодорхойлогдоогүй</span></span>
            {% if m.un_source.reason %}<span class="chain-why">{{ m.un_source.reason }}</span>{% endif %}
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if is_index and stats.all.total %}
  <section class="theme archive-stats">
    <h3 class="theme-head"><span class="en">Since {{ stats.all.since }}</span><span class="mn">{{ stats.all.since }}-наас хойш</span></h3>

    <div class="stat-grid">
      <div class="stat"><span class="n">{{ stats.all.total }}</span><span class="l"><span class="en">mentions</span><span class="mn">дурдсан</span></span></div>
      <div class="stat"><span class="n">{{ stats.all.outlet_count }}</span><span class="l"><span class="en">outlets</span><span class="mn">хэвлэл</span></span></div>
      <div class="stat"><span class="n">{{ stats.all.matched_pct }}%</span><span class="l"><span class="en">source identified</span><span class="mn">эх сурвалж тодорхой</span></span></div>
      <div class="stat"><span class="n">{{ stats.all.weeks }}</span><span class="l"><span class="en">weeks tracked</span><span class="mn">долоо хоног</span></span></div>
    </div>

    <div class="two-col">
      <div>
        <h5 class="mini-head"><span class="en">Most frequent outlets</span><span class="mn">Хамгийн их бичсэн</span></h5>
        <ul class="bars">
          {% for name, counts in stats.all.by_outlet %}
          <li>
            <span class="bar-label">{{ name }}</span>
            <span class="bar">
              {% for t, n in counts.tones %}{% if n %}<span class="seg tone-{{ t | lower }}" style="flex:{{ n }}" title="{{ n }} {{ t }}"></span>{% endif %}{% endfor %}
            </span>
            <span class="bar-n">{{ counts.total }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h5 class="mini-head"><span class="en">Most cited agencies</span><span class="mn">Хамгийн их дурдагдсан</span></h5>
        <ul class="bars">
          {% for name, counts in stats.all.by_agency %}
          <li>
            <span class="bar-label">{{ name }}</span>
            <span class="bar">
              {% for t, n in counts.tones %}{% if n %}<span class="seg tone-{{ t | lower }}" style="flex:{{ n }}" title="{{ n }} {{ t }}"></span>{% endif %}{% endfor %}
            </span>
            <span class="bar-n">{{ counts.total }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <h5 class="mini-head"><span class="en">Week by week</span><span class="mn">Долоо хоногоор</span></h5>
    <ul class="bars weekly">
      {% for w in stats.all.by_week %}
      <li>
        <span class="bar-label"><a href="{{ root }}media/{{ w.slug }}.html">{{ w.label }}</a></span>
        <span class="bar">
          {% for t, n in w.tones %}{% if n %}<span class="seg tone-{{ t | lower }}" style="flex:{{ n }}" title="{{ n }} {{ t }}"></span>{% endif %}{% endfor %}
        </span>
        <span class="bar-n">{{ w.total }}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <footer class="disclaimer">
    <span class="en">Method: mentions are found through open-source search of the outlets listed in the office's shared source list, then read in full. Tone describes how the United Nations is presented in the article, not the quality of the reporting, and is an automated judgement reviewed by a member of staff before publication. A source is marked as linked when the article itself links to a United Nations page; otherwise it is inferred from shared figures, wording and dates, and shown with its confidence. Inclusion does not imply endorsement or verification by the United Nations.</span>
    <span class="mn">Арга зүй: дурдалтуудыг нээлттэй эх сурвалжийн хайлтаар олж, бүрэн эхээр нь уншсан болно. Өнгө аяс нь НҮБ-ыг тухайн нийтлэлд хэрхэн танилцуулсныг илэрхийлэх бөгөөд сэтгүүл зүйн чанарыг үнэлэхгүй. Уг үнэлгээг автоматаар гаргаж, нийтлэхийн өмнө ажилтан хянадаг.</span>
  </footer>
</main>

<script src="{{ root }}app.js"></script>
</body>
</html>
